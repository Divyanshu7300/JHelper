# LinkedIn Credentials (auto-login via email+password)
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password

# Naukri Credentials (auto-login via email+password)
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password

# Indeed — NO credentials needed here!
# Indeed uses Google / OTP login. Run this once to set up:
#   python main.py setup-session --platform indeed

# Optional: Google Gemini API Key for smart AI answers to custom/behavioral application questions
# (If not provided, the built-in offline smart AI engine will answer automatically)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Telegram Remote Control & Alerts
# 1. Create a bot on Telegram with @BotFather -> get BOT_TOKEN
# 2. Start a chat with your bot on Telegram -> get your CHAT_ID (or send /start to auto-bind)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
